rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        "andrea_ramirezt@cun.edu.co",
        "angela_bernalm@cun.edu.co",
        "jose_forero@cun.edu.co"
      ];
    }

    // Documentos de compañeros: autenticados suben, admin elimina
    match /documentos/{colleagueId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Documentos de grupos: miembros autenticados suben, admin elimina
    match /documentos-grupo/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Avatares de perfil
    match /avatares/{colleagueId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Archivos adjuntos a tareas individuales
    match /tareas/{colleagueId}/{taskId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Archivos adjuntos a tareas de grupo
    match /tareas-grupo/{groupId}/{taskId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

  }
}
