rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        "andrea_ramirezt@cun.edu.co",
        "angela_bernalm@cun.edu.co",
        "jose_forero@cun.edu.co"
      ];
    }

    function isGrupoMember(equipoId) {
      let eq = get(/databases/$(database)/documents/equipos/$(equipoId));
      return request.auth != null &&
        eq.data.get("memberUids", []).hasAny([request.auth.uid]);
    }

    function isGrupoMemberOrAdmin(equipoId) {
      return isAdmin() || isGrupoMember(equipoId);
    }

    function isColleagueOwner(docId) {
      return request.auth != null && (
        request.auth.uid == get(/databases/$(database)/documents/companeros/$(docId)).data.uid ||
        request.auth.token.email == get(/databases/$(database)/documents/companeros/$(docId)).data.email
      );
    }

    // ── Compañeros ──────────────────────────────────────────────
    match /companeros/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isColleagueOwner(docId);

      // Retroalimentación: solo admin escribe, el dueño y admin leen
      match /retroalimentacion/{fbId} {
        allow read: if request.auth != null && (isAdmin() || isColleagueOwner(docId));
        allow create: if isAdmin();
        allow update, delete: if isAdmin();
      }

      // Tareas: admin crea/elimina, dueño y admin actualizan, ambos leen
      match /tareas/{taskId} {
        allow read: if request.auth != null && (isAdmin() || isColleagueOwner(docId));
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || isColleagueOwner(docId);
      }

      // Documentos: dueño y admin suben, admin elimina, dueño y admin leen
      match /documentos/{documentId} {
        allow read: if request.auth != null && (isAdmin() || isColleagueOwner(docId));
        allow create: if isAdmin() || isColleagueOwner(docId);
        allow delete: if isAdmin();
      }
    }

    // ── Bitácora (logs) ─────────────────────────────────────────
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.creadoPor);
    }

    // ── Notificaciones de tareas ────────────────────────────────
    match /notificaciones/{notifId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    // ── Notificaciones personales por usuario ───────────────────
    match /notif_usuario/{uid} {
      match /items/{itemId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
      }
    }

    // ── Cola de notificaciones WhatsApp ─────────────────────────
    match /wpp_queue/{docId} {
      allow create: if isAdmin();
      allow read, update: if false; // solo Admin SDK vía Cloud Functions
    }

    // ── Equipos ─────────────────────────────────────────────────
    match /equipos/{equipoId} {
      allow read, write: if request.auth != null;

      match /logs/{logId} {
        allow read: if isGrupoMemberOrAdmin(equipoId);
        allow create: if isGrupoMemberOrAdmin(equipoId);
        allow update, delete: if isAdmin() ||
          (request.auth != null && request.auth.uid == resource.data.creadoPor);
      }

      match /tareas/{taskId} {
        allow read: if isGrupoMemberOrAdmin(equipoId);
        allow create, delete: if isAdmin();
        allow update: if isGrupoMemberOrAdmin(equipoId);
      }

      match /retroalimentacion/{fbId} {
        allow read: if isGrupoMemberOrAdmin(equipoId);
        allow write: if isAdmin();
      }

      match /documentos/{docId} {
        allow read: if isGrupoMemberOrAdmin(equipoId);
        allow create: if isGrupoMemberOrAdmin(equipoId);
        allow delete: if isAdmin();
      }

      match /contactos/{contactId} {
        allow read: if isAdmin();
        allow create, delete: if isAdmin();
      }
    }

  }
}
